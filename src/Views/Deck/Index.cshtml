@model IEnumerable<FlashcardApp.Models.Deck>
<div class="container mt-5">
    
    <!-- STANDARD DECKS SECTION -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Available Decks</h2>
        <div>
            <a asp-action="CreateDeck" class="btn btn-success">+ Create New</a>
            <a asp-action="ImportDeck" class="btn btn-outline-primary">Import JSON</a>
        </div>
    </div>
    <div class="list-group mt-3">
        @if (!Model.Any(d => !d.IsReviewDeck)) { 
            <p class="text-muted">No standard decks found. Create or import one to get started!</p> 
        }
        @foreach (var deck in Model.Where(d => !d.IsReviewDeck)) {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <h5>@deck.Title</h5>
                    <small class="text-muted">@deck.Cards.Count cards</small>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Study" asp-route-deckId="@deck.Id" class="btn btn-primary btn-sm">Study</a>
                    <a asp-action="EditDeck" asp-route-id="@deck.Id" class="btn btn-warning btn-sm">Edit</a>
                </div>
            </div>
        }
    </div>

    <hr class="my-5" />

    <!-- REVIEW DECKS SECTION -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Review Decks</h2>
    </div>
    <div class="list-group mt-3">
        @if (!Model.Any(d => d.IsReviewDeck)) { 
            <p class="text-muted">No review decks yet. Start studying to generate review sessions!</p> 
        }
        @foreach (var deck in Model.Where(d => d.IsReviewDeck)) {
            <div class="list-group-item d-flex justify-content-between align-items-center bg-light">
                <div>
                    <h5>
                        @deck.Title
                        <span class="badge bg-warning text-dark ms-2">Review</span>
                    </h5>
                    <small class="text-muted">@deck.Cards.Count cards</small>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Study" asp-route-deckId="@deck.Id" class="btn btn-primary btn-sm">Review</a>
                    <a asp-action="EditDeck" asp-route-id="@deck.Id" class="btn btn-warning btn-sm">Edit</a>
                    
                    <form asp-action="DeleteDeck" asp-route-id="@deck.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this review deck?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>

</div>
