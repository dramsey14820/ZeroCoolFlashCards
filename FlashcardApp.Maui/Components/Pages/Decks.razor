@page "/"
@page "/decks"
@inject StudyService StudyService
@inject NavigationManager Navigation

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Flashcard Decks</h1>
        <button class="btn btn-success" @onclick="CreateDeck">+ Create</button>
    </div>

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Unable to load decks.</strong>
            <div>@_loadError</div>
        </div>
    }
    else if (_decks is null)
    {
        <p>Loading decks...</p>
    }
    else
    {
        <h2>Available Decks</h2>
        @foreach (var deck in _decks.Where(d => !d.IsReviewDeck))
        {
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@deck.Title</h5>
                        <small class="text-muted">@deck.Cards.Count cards</small>
                    </div>
                    <button class="btn btn-primary" @onclick="() => StudyDeck(deck.Id)">Study</button>
                </div>
            </div>
        }

        <h2 class="mt-4">Review Decks</h2>
        @foreach (var deck in _decks.Where(d => d.IsReviewDeck))
        {
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@deck.Title</h5>
                        <small class="text-muted">@deck.Cards.Count cards</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="() => StudyDeck(deck.Id)">Review</button>
                        <button class="btn btn-danger" @onclick="() => DeleteDeck(deck)">Delete</button>
                    </div>
                </div>
            </div>
        }
    }

    @if (_creating)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h4>Create Deck</h4>
                <input class="form-control mb-2" placeholder="Title" @bind="_newTitle" />
                <input class="form-control mb-3" placeholder="Front | Back" @bind="_newCardText" />
                <div class="d-flex gap-2">
                    <button class="btn btn-success" @onclick="SaveNewDeck">Save</button>
                    <button class="btn btn-secondary" @onclick="() => _creating = false">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Deck>? _decks;
    private string? _loadError;
    private bool _creating;
    private string _newTitle = "";
    private string _newCardText = "";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _loadError = null;
            _decks = await StudyService.GetAllDecksAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private void StudyDeck(string deckId)
    {
        Navigation.NavigateTo($"/study/{deckId}");
    }

    private void CreateDeck()
    {
        _creating = true;
        _newTitle = "";
        _newCardText = "";
    }

    private async Task SaveNewDeck()
    {
        if (string.IsNullOrWhiteSpace(_newTitle))
        {
            return;
        }

        var deck = new Deck
        {
            Id = _newTitle.Trim().Replace(" ", "_").ToLowerInvariant(),
            Title = _newTitle.Trim()
        };

        if (!string.IsNullOrWhiteSpace(_newCardText))
        {
            var separatorIndex = _newCardText.IndexOf('|');
            if (separatorIndex >= 0)
            {
                deck.Cards.Add(new Flashcard
                {
                    Front = _newCardText[..separatorIndex].Trim(),
                    Back = _newCardText[(separatorIndex + 1)..].Trim()
                });
            }
        }

        await StudyService.SaveDeckAsync(deck);
        _creating = false;
        await ReloadAsync();
    }

    private async Task DeleteDeck(Deck deck)
    {
        StudyService.DeleteDeck(deck.Id);
        await ReloadAsync();
    }
}
