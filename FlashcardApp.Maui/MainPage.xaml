<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FlashcardApp.Maui"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:components="clr-namespace:FlashcardApp.Maui.Components"
             x:Class="FlashcardApp.Maui.MainPage">

    <Grid BackgroundColor="White">
        <Label Text="Starting ZeroCool Flashcards..."
               TextColor="Black"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="False" />
        <blazor:BlazorWebView x:Name="blazorWebView"
                              HostPage="wwwroot/index.html"
                              BlazorWebViewInitialized="OnBlazorWebViewInitialized"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill">
            <blazor:BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
        <Border x:Name="startupStatusPanel"
                BackgroundColor="White"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="False">
            <Label x:Name="startupStatusLabel"
                   Text="Starting ZeroCool Flashcards..."
                   TextColor="Black" />
        </Border>
    </Grid>

</ContentPage>
